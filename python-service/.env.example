LLM_PROVIDER=grok
LLM_MODEL=grok-4.20-reasoning
# Set one key variable below (do not commit real values)
GROK_API_KEY=
# XAI_API_KEY=  # Alternative name if preferred
GROK_BASE_URL=https://api.x.ai/v1

# Dip-insight emails use Grok Responses API + native x_search (no X Developer API key required).
# Node backend POST /agent/daily-watchlist-digest uses the same Grok key for scheduled daily watchlist emails.
# Models that support agentic tools (e.g. grok-4.3 in docs) work best; set false to force snippet-less fallback only.
# DIP_INSIGHT_USE_X_SEARCH=true

# Optional OpenAI-compatible settings
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Opportunity graph: Phase 2 tools call Node `/api/charts/*` (same Massive data as the app)
# NODE_BACKEND_URL=http://127.0.0.1:3001

# Must match backend AGENT_INTERNAL_SECRET for internal agent API (GET/POST /api/internal/agent/alerts,
# GET /api/internal/research/artifacts — watchlist-scoped news rows for LangGraph)
# AGENT_INTERNAL_SECRET=

# §11 Phase C — optional overrides for research headline digest in opportunity scan replies
# RESEARCH_CONTEXT_LOOKBACK_HOURS=24
# RESEARCH_CONTEXT_ARTIFACT_LIMIT=50

# When true + mode auto_apply_low_risk: LangGraph creates top-candidate alert via Node internal API.
# Avoid enabling together with frontend "auto-apply" on /ai-agent (duplicate alert / 409).
# LANGGRAPH_ALLOW_INTERNAL_ALERT_CREATE=false
