# Server Configuration
NODE_ENV=production
PORT=3001
# Public HTTPS origin for email links + RFC 2369 List-Unsubscribe (must match your SES verified domain).
FRONTEND_URL=https://app.keepitbased.com

# Behind nginx or a load balancer: set so req.ip + rate limits (auth, SES recovery email) use the real client.
# Use 0 for local dev without a proxy. Default in code is 1 hop if unset.
# TRUST_PROXY_HOPS=1

# Port pre-bind check: off in production by default. Set true to enable (e.g. debugging);
# in development set false to skip the check.
# RUN_PORT_AVAILABILITY_CHECK=true

# Database - Use environment variables or connection string
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/keepitbased
REDIS_URL=redis://localhost:6379

# --- Supabase (global live chat) — optional; add when you have a project ------------
# Dashboard → Settings → API (same project as the frontend anon key)
#   SUPABASE_URL                 = Project URL (https://xxxxx.supabase.co) no trailing slash
#   SUPABASE_SERVICE_ROLE_KEY    = service_role secret (server ONLY — never in frontend)
# Run SQL in `supabase/migrations/` then enable Realtime on the two tables if needed.
# See `supabase/README.md`
# Use SUPABASE_* here (not NEXT_PUBLIC_* — those belong in the frontend only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: apply chat tables from your machine (`npm run migrate:supabase-chat` or `npm run setup:supabase-chat`).
# Either paste the full connection URI:
# SUPABASE_DB_URL=postgresql://...
# Or set only the Database password (same as Supabase → Settings → Database) with SUPABASE_URL already set:
# SUPABASE_DB_PASSWORD=

# JWT - CRITICAL: Generate a strong, random secret
JWT_SECRET=your-super-secure-jwt-secret-here-minimum-32-characters
JWT_EXPIRES_IN=7d

# Invite-only registration: seeded into DB once if app_settings.signup_invite_hash is unset. Remove plaintext after bootstrap.
INVITE_SIGNUP_CODE=
# Comma-separated emails of users allowed to PUT /api/admin/signup-invite (rotate signup code via Profile UI).
ADMIN_SIGNUP_EMAILS=you@example.com

# API Keys - Get these from respective providers
ALPHA_VANTAGE_API_KEY=
MASSIVE_API_KEY=
POLYGON_API_KEY=
# Polygon-compatible REST host. Use https://api.massive.com for keys from massive.com; default polygon.io for legacy keys.
# MARKET_DATA_API_URL=https://api.massive.com
COINAPI_KEY=

# iTick — non-US equities (Taiwan TWSE first; US stocks stay on Polygon/Massive)
# https://docs.itick.io — dashboard token → ITICK_API_TOKEN
ITICK_API_TOKEN=
# ITICK_API_BASE_URL=https://api.itick.io
# ITICK_TW_ENABLED=true
# ITICK_REQUEST_TIMEOUT_MS=15000
# Regenerate English search aliases: npm run build:tw-aliases (writes backend/data/twEnglishAliases.json)

# §11 Phase B — Polygon/Massive reference news → DB table research_artifacts (same cron process as API)
# ENABLE_RESEARCH_INGESTION=true
# RESEARCH_NEWS_CRON=*/10 * * * *
# RESEARCH_NEWS_MAX_SYMBOLS_PER_RUN=30
# RESEARCH_NEWS_PER_SYMBOL_LIMIT=10
# RESEARCH_NEWS_SYMBOL_DELAY_MS=600
# §11 Phase D — when Profile `researchDigestEmail` is true, Grok dip email requires research_artifacts in this window
# RESEARCH_FUSION_LOOKBACK_HOURS=24

# LangGraph / Python agent — shared secret for GET/POST /api/internal/agent/* (must match python-service)
# AGENT_INTERNAL_SECRET=

# Email (for alerts) — put real values only in backend/.env (gitignored), never in example files.
# AWS SES: host is email-smtp.<region>.amazonaws.com:587 — MUST match the region where you created SMTP credentials (e.g. us-east-1 N. Virginia).
# IAM → user → Security credentials → create SMTP credentials; SMTP_USER is the generated username; SMTP_PASS is the password.
# Set SMTP_FROM to a verified address/identity in SES (e.g. noreply@yourdomain.com). Do not use display-name spoofing.
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=YOUR_SES_SMTP_USERNAME
SMTP_PASS=YOUR_SES_SMTP_PASSWORD
SMTP_FROM=noreply@keepitbased.com

# After SES incidents: rotate SMTP credentials in IAM; do not commit real secrets.
# https://repost.aws/knowledge-center/ses-rotate-smtp-access-keys

# Cloudflare Turnstile on forgot-username / forgot-password (recommended in production).
# Dashboard → Turnstile → create widget → site key + secret. When TURNSTILE_SECRET_KEY is set, the API requires a valid token.
# https://developers.cloudflare.com/turnstile/
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Ingest SES bounce/complaint notifications (forward SNS JSON to this URL with the bearer secret).
# POST /api/webhooks/ses-delivery  Authorization: Bearer <SES_WEBHOOK_SECRET>
# https://docs.aws.amazon.com/ses/latest/dg/notification-contents.html
SES_WEBHOOK_SECRET=

# Marketing-style email (digest, opportunity, legacy price alerts) is skipped if the user has not logged in
# within 6 months (email_last_seen_at, fallback created_at). Set true to disable that gate during migration.
# DISABLE_EMAIL_ENGAGEMENT_SUNSET=true

# AWS Billing → enable Cost Explorer for SES usage/cost trends.
# https://docs.aws.amazon.com/aws-cost-management/latest/userguide/ce-what-is.html

# Dip briefing emails (Grok + xAI x_search; no X Developer API). When unset/false, plain opportunity emails only.
# ENABLE_DIP_INSIGHT_EMAIL=true
# Emergency: set true to block Grok dip briefings without changing ENABLE_*

# UltimateDipBuyer AI — optional email gates (assessment still saved on /opportunity-signals when Grok succeeds):
# Only send the rich HTML email when Grok returns Strong Buy or Buy (Hold/Pass → no email; see signals inbox).
# DIP_INSIGHT_EMAIL_REQUIRE_BUY_VERDICT=true
# Also require confidence >= N (0–100) for email:
# DIP_INSIGHT_MIN_CONFIDENCE_FOR_EMAIL=55

# Legacy 5/10/15% threshold "BUY SIGNAL" emails — default OFF (uses SES quota). Opportunity dip emails are the path for watchlist.
# ENABLE_LEGACY_THRESHOLD_ALERT_EMAILS=true

# Daily watchlist digest (Grok via Python) — default OFF. Opt-in: ENABLE_DAILY_WATCHLIST_DIGEST_EMAIL=true + Profile toggle.
# Kill switch: DISABLE_DAILY_WATCHLIST_DIGEST_EMAIL=true
# Hours of Polygon headlines to bundle per user (symbols on alerts watchlist): DAILY_DIGEST_RESEARCH_LOOKBACK_HOURS=72
# DAILY_WATCHLIST_DIGEST_CRON=0 7 * * *
# DAILY_WATCHLIST_DIGEST_STAGGER_MS=2500

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
CHARTS_QUOTE_RATE_WINDOW_MS=60000
CHARTS_QUOTE_RATE_MAX=120
CHARTS_HISTORY_RATE_WINDOW_MS=60000
CHARTS_HISTORY_RATE_MAX=60

# Agent / internal API rate limits (per user id where applicable)
# AGENT_APPLY_RATE_WINDOW_MS=60000
# AGENT_APPLY_RATE_MAX=15
# AGENT_AUDIT_RATE_WINDOW_MS=60000
# AGENT_AUDIT_RATE_MAX=60
# INTERNAL_AGENT_READ_WINDOW_MS=60000
# INTERNAL_AGENT_READ_MAX=120
# INTERNAL_AGENT_WRITE_WINDOW_MS=60000
# INTERNAL_AGENT_WRITE_MAX=30

# Alert Settings
PRICE_CHECK_INTERVAL_MS=60000
MAX_ALERTS_PER_USER=50

# Destructive DELETE routes (/api/alerts/:id, /api/watchlist/symbols/:sym) require header X-Confirm-Delete: 1.
# The web app sends this automatically. For curl/scripts, add -H "X-Confirm-Delete: 1".
# NEVER set in production:
# SKIP_DELETE_CONFIRMATION=true

# Watchlist opportunity signals — default is ATR-normalized (14-day Wilder ATR from daily bars).
# Use pct for legacy fixed-% vs baseline only (no Polygon daily fetch for ATR).
# OPPORTUNITY_TRIGGER_MODE=atr
# OPPORTUNITY_ON_SALE_ATR_MULT=1.25
# OPPORTUNITY_OVERREACTION_ATR_MULT=2.5
# OPPORTUNITY_ON_SALE_DROP_PCT=5
# OPPORTUNITY_OVERREACTION_DROP_PCT=12
# OPPORTUNITY_VOL_SPIKE_MULT=2
# OPPORTUNITY_DEDUPE_TTL_SEC=3600
# Phase 2 email timing — 2-of-3 minute polls before send; separate oppmail:sent dedupe per hour.
# OPPORTUNITY_EMAIL_CONFIRM_ENABLED=true
# OPPORTUNITY_EMAIL_CONFIRM_HITS=2
# OPPORTUNITY_EMAIL_CONFIRM_POLLS=3
# OPPORTUNITY_EMAIL_CONFIRM_SKIP_CAPITULATION=true
# OPPORTUNITY_STOCK_OFFHOURS_POLL_MIN=5
# OPPORTUNITY_EMAIL_MORNING_BATCH_ENABLED=true
# Phase 3 — durable email_outbox table + worker (instant queue or hourly digest batches).
# ENABLE_EMAIL_OUTBOX=true
# EMAIL_OUTBOX_CRON=*/1 * * * *
# EMAIL_OUTBOX_BATCH_SIZE=20
# EMAIL_OUTBOX_MAX_ATTEMPTS=5
# Phase 4 — Grok dip insight: larger tiers only, daily cap, async worker (non-blocking price cron).
# DIP_INSIGHT_REQUIRE_OVERREACTION_TIER=true
# DIP_INSIGHT_ASYNC_VIA_OUTBOX=true
# DIP_INSIGHT_OUTBOX_PER_TICK=2
# Long-term capitulation tier (parallel): 50-day ATR smooths multi-week moves; dedupe default 24h.
# OPPORTUNITY_CAPITULATION_ATR14_MULT=4
# OPPORTUNITY_CAPITULATION_ATR50_MULT=3
# OPPORTUNITY_CAPITULATION_FROM_52W_PCT=20
# OPPORTUNITY_CAPITULATION_FALLBACK_52W_PCT=18
# OPPORTUNITY_CAPITULATION_MEGA_CAP_ATH_PCT=15
# Mega-cap optional ATH rule — comma-separated tickers, or NONE to disable (defaults apply when unset).
# OPPORTUNITY_MEGA_CAP_SYMBOLS=AAPL,MSFT,NVDA,META,GOOGL,GOOG,AMZN,TSLA
# OPPORTUNITY_CAPITULATION_DEDUPE_TTL_SEC=86400
# Short-tier trend filter (optional): on_sale / overreaction only when last price > N-day SMA; capitulation ignores.
# OPPORTUNITY_SHORT_TREND_FILTER_ENABLED=true
# OPPORTUNITY_SHORT_TREND_SMA_DAYS=200
# Ignore ATR when volatility is tiny vs price (percent of price, e.g. 0.05 = 0.05%). 0 = off.
# OPPORTUNITY_ATR_MIN_PCT_OF_PRICE=0
# Future ideas (not implemented): VIX-scaled thresholds, per-watchlist mega-cap list, agent “context” line on cap alerts.

# Python Service
PYTHON_SERVICE_URL=http://127.0.0.1:5001
# GET /api/fundamentals/:symbol (JWT auth) proxies to PYTHON_SERVICE_URL/stock/:symbol/fundamentals (yfinance).
# FUNDAMENTALS_PYTHON_TIMEOUT_MS=28000
# FUNDAMENTALS_RATE_WINDOW_MS=60000
# FUNDAMENTALS_RATE_MAX=48

# Quant AGI sidecar (optional): opportunity toasts merge `quantAgi`; DB `ai_assessment.quant_agi`
# QUANT_AGI_ENHANCE_URL=http://127.0.0.1:8844
# QUANT_AGI_TIMEOUT_MS=3500
ENABLE_LANGGRAPH_AGENT=false
# Node → Python timeout for POST /api/agent/chat proxy (ms, 15000–180000; default 120000).
# AGENT_PYTHON_TIMEOUT_MS=120000

# X / Twitter API v2 — optional live feed from investor accounts you configure (official API only).
# Create an app at developer.x.com, generate Bearer token (OAuth 2.0 App-only).
# X_MONITORED_ACCOUNTS_JSON: numeric user IDs (not handles). Example:
# X_MONITORED_ACCOUNTS_JSON=[{"id":"1234567890123456789","username":"exampleinv","label":"Example"}]
# X_API_BEARER_TOKEN=

# Security Headers (for production)
SECURITY_HEADERS_ENABLED=true
CORS_ENABLED=true
CORS_ORIGIN=https://keepitbased.com

# Session Security
SESSION_SECRET=
SESSION_SECURE=true
SESSION_HTTPONLY=true
SESSION_SAMESITE=strict

# Monitoring
ENABLE_REQUEST_LOGGING=true
ENABLE_ERROR_REPORTING=true

