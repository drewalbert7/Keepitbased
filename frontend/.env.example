# Frontend environment (copy to `.env.development` or `.env.local` and fill in).
# CRA only exposes variables prefixed with REACT_APP_.

# API base (dev: full URL to backend; prod build: often `/api` behind same host)
REACT_APP_API_URL=http://localhost:3001/api

# Quant AGI operator tab: optional base URL (no trailing slash) to load /diag/experiments in the browser
# REACT_APP_QUANT_AGI_URL=http://127.0.0.1:8844

# ---------------------------------------------------------------------------
# Supabase — global live chat (optional until you add keys)
# Dashboard: https://supabase.com/dashboard → your project → Settings → API
#   REACT_APP_SUPABASE_URL     = "Project URL" (https://xxxxx.supabase.co)
#   REACT_APP_SUPABASE_ANON_KEY = "anon" "public" key (safe in browser)
# Posting still goes through your API + JWT; anon is used for Realtime only.
# Schema: see repo `supabase/README.md` and `supabase/migrations/`.
# ---------------------------------------------------------------------------
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=
