{
  "name": "keepitbased",
  "version": "1.0.0",
  "description": "Crypto and Stock Alert System",
  "main": "backend/server.js",
  "scripts": {
    "dev:backend": "cd backend && nodemon server.js",
    "dev:frontend": "cd frontend && npm start",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "cd frontend && npm run build",
    "start": "cd backend && node server.js",
    "test:charts": "cd backend && npm run test:charts",
    "precommit": "npm run security:secrets",
    "security:secrets": "node backend/scripts/checkSecrets.js",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop all",
    "pm2:restart": "pm2 restart all",
    "deploy": "bash scripts/deploy-production.sh",
    "health:api": "curl -sf http://127.0.0.1:3001/api/health && echo",
    "smoke:opportunity": "bash scripts/smoke-opportunity-agent.sh",
    "golden:opportunity": "node scripts/runGoldenOpportunities.js",
    "golden:dip-insight": "node scripts/runGoldenDipInsight.js",
    "research:ingest-once": "node scripts/runResearchIngestionOnce.js",
    "email:test-opportunity": "cd backend && npm run email:test-opportunity",
    "email:verify-smtp": "cd backend && npm run email:verify-smtp",
    "digest:run-once": "cd backend && npm run digest:run-once",
    "quant:autoresearch-nightly": "bash scripts/run-quant-autoresearch-nightly.sh"
  },
  "dependencies": {
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "http-proxy-middleware": "^3.0.5"
  },
  "keywords": [
    "crypto",
    "stocks",
    "alerts",
    "trading",
    "robinhood"
  ],
  "author": "KeepItBased",
  "license": "MIT"
}
