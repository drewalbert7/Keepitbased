# KeepItBased repo path (parent folder of quant_agi)
# KEEPITBASED_ROOT=/path/to/keepitbased

# Massive/Polygon aggregates (merged from backend / python-service .env when present)
# MARKET_DATA_API_URL=https://api.massive.com
# POLYGON_API_KEY=
# MASSIVE_API_KEY=
# QUANT_AGI_SYNTHETIC_HISTORY_ONLY=false

# LLM proposals — uses same keys as python-service/.env when those files exist (merged automatically).
# Prefer QUANT_AGI_LLM_PROVIDER here if LLM_PROVIDER is reserved for LangGraph-only (e.g. none vs grok).
# QUANT_AGI_LLM_PROVIDER=grok
# LLM_PROVIDER=none
# --- Grok (xAI) — autoresearch reasoning + optional generated_modules → git sandbox grok_artifacts/
# GROK_API_KEY=
# XAI_API_KEY=   # alias for GROK_API_KEY
# GROK_BASE_URL=https://api.x.ai/v1
# GROK_MODEL=grok-4.20-reasoning
# LLM_MODEL=grok-4.20-reasoning   # shared with python-service — either works
# GROK_REQUEST_TIMEOUT_SEC=90
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Safety
EXPERIMENT_MAX_RUNTIME_SEC=3600
NIGHTLY_MAX_ITERATIONS=3
# Bounded synthetic evaluator (does not throttle interactive CLI swarm size)
# AUTORESEARCH_EVAL_AGENTS=896
# AUTORESEARCH_EVAL_ROUNDS=6

# Swarm sizing (maps to pydantic Settings field names lowercase)
SWARM_DEFAULT_AGENTS=5000
SWARM_MAX_AGENTS=100000

# Webhook
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8844
# Browser CORS for /diag/* when running `main.py serve`
# QUANT_AGI_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Torch preference (logical label; CPU image by default)
TORCH_DEVICE=cpu

# Company fundamentals (Flask python-service — same URL as KEEPITBASED Node charts agent)
# KEEPITBASED_PYTHON_SERVICE_URL=http://127.0.0.1:5001
# PYTHON_SERVICE_URL=http://127.0.0.1:5001

# Slow: SEC EDGAR HTML keyword density for filing leg (respect fair access; include contact in User-Agent)
# QUANT_AGI_SEC_FILING_SCAN=false
# SEC_DATA_USER_AGENT="YourOrg QuantBot/1.0 contact@yourorg.com"
